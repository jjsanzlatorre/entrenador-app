# ── Públicas (se incrustan en el bundle del cliente; es seguro exponerlas) ──
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → "anon public" (o la "publishable key" sb_publishable_…)
VITE_SUPABASE_ANON_KEY=

# ── Solo servidor (NUNCA con prefijo VITE_) ──
# Supabase → Project Settings → API Keys → "service_role" (o la "secret key" sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=

# ── Entrenador IA (solo servidor, opcional: sin clave la app funciona sin IA) ──
# Proveedor: gemini (por defecto) o anthropic
AI_PROVIDER=gemini
# Google AI Studio → Get API key (plan gratuito)
GEMINI_API_KEY=
# Modelo de Gemini (opcional; por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Solo si AI_PROVIDER=anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo de Anthropic (opcional; por defecto claude-sonnet-5-5)
AI_MODEL=claude-sonnet-5-5
# Consultas a la IA por usuario y día (opcional; por defecto 20)
AI_DAILY_LIMIT=20
