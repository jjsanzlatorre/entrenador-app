# ── Públicas (se incrustan en el bundle del cliente; es seguro exponerlas) ──
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → "anon public" (o la "publishable key" sb_publishable_…)
VITE_SUPABASE_ANON_KEY=

# ── Solo servidor (NUNCA con prefijo VITE_) ──
# Supabase → Project Settings → API Keys → "service_role" (o la "secret key" sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=

# ── Entrenador IA (solo servidor, opcional: sin clave la app funciona sin IA) ──
# Proveedor: gemini (por defecto) o anthropic
AI_PROVIDER=gemini
# Google AI Studio → Get API key (plan gratuito)
GEMINI_API_KEY=
# Modelo de Gemini (opcional; por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Modelo de Gemini para las tareas pesadas (opcional): generar o personalizar un plan (también el
# «Crear plan» del chat) y la revisión semanal. Vacío = todo con GEMINI_MODEL.
GEMINI_MODEL_HEAVY=
# Modelo de reserva de Gemini (opcional): si el principal devuelve 429 o cuota agotada, se
# reintenta una vez con este antes de mostrar el aviso. Vacío = sin reserva.
GEMINI_FALLBACK_MODEL=
# Solo si AI_PROVIDER=anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo de Anthropic (opcional; por defecto claude-sonnet-5)
AI_MODEL=claude-sonnet-5
# Consultas a la IA por usuario y día (opcional; por defecto 20)
AI_DAILY_LIMIT=20

# ── Notificaciones push (solo servidor, opcional: sin claves no hay notificaciones) ──
# Genera las claves en la app: Perfil → Notificaciones → «Generar claves nuevas» (solo admin).
# Pública VAPID (base64url, 87 caracteres). Aunque sea pública, va sin prefijo VITE_: el
# navegador la pide al servidor.
VAPID_PUBLIC_KEY=
# Privada VAPID (base64url, 43 caracteres). NUNCA la compartas.
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push: mailto:tu@email
VAPID_SUBJECT=mailto:
# Secreto que usa pg_cron para llamar a /api/push/cron (el mismo que en supabase/snippets/push_cron.sql)
CRON_SECRET=
